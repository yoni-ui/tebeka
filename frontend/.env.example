# Optional: absolute API origin (e.g. https://api.example.com). If empty, the app calls same-origin
# /backend/* which next.config.mjs rewrites to BACKEND_URL (FastAPI).
NEXT_PUBLIC_API_URL=

# Next.js server: FastAPI base for rewrites (dev/prod).
BACKEND_URL=http://127.0.0.1:8000

# Admin panel login (POST /api/auth/admin-sign-in). Change in production.
ADMIN_PANEL_SECRET=change-me-admin

# Set to "true" to skip /app and /admin cookie checks (local UI work only).
NEXT_PUBLIC_AUTH_DISABLED=
